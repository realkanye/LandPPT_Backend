# =============================================================================
# LandPPT 生产环境配置模板（内部 API 部署专用）
# =============================================================================
# 使用方式：
#   cp .env.production.example .env
#   按照各分区说明填写必要项，然后启动服务
#
# K8s 部署时：
#   - 非敏感项  → ConfigMap
#   - 带 [SECRET] 标注的项 → K8s Secret
# =============================================================================


# =============================================================================
# 【必须配置】AI 提供商
# 选择一个提供商并填写对应的 API Key，其余提供商的配置留空即可。
# =============================================================================

# 当前使用的提供商（openai / anthropic / google / azure_openai）
DEFAULT_AI_PROVIDER=openai

# ── OpenAI / 兼容接口（推荐）──────────────────────────────────────────────
# [SECRET] OpenAI API Key
OPENAI_API_KEY=

# 模型名称，推荐 gpt-4o（生成质量更好）或 gpt-4o-mini（更快更省）
OPENAI_MODEL=gpt-4o

# 如果走公司内部 AI 中转网关，将此地址改为中转地址；否则保持官方地址
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic（Claude）────────────────────────────────────────────────────
# [SECRET] Anthropic API Key（使用 Anthropic 时填写，否则留空）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Google Gemini ──────────────────────────────────────────────────────────
# [SECRET]（使用 Google 时填写，否则留空）
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# ── Azure OpenAI ───────────────────────────────────────────────────────────
# [SECRET]（使用 Azure 时填写，否则留空）
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15-preview


# =============================================================================
# 【必须配置】数据库
# 生产环境必须使用 PostgreSQL，禁止使用 SQLite。
# =============================================================================

# [SECRET] PostgreSQL 连接串
# 格式: postgresql://<user>:<password>@<host>:<port>/<dbname>
# K8s 中 host 填 PostgreSQL Service 名称
DATABASE_URL=postgresql://landppt:CHANGE_ME@landppt-postgres:5432/landppt

# 启动时自动执行数据库迁移（保持 true，由应用自身完成，无需手动跑 alembic）
LANDPPT_AUTO_MIGRATE_ON_STARTUP=true
LANDPPT_AUTO_MIGRATE_FAIL_FAST=true


# =============================================================================
# 【必须配置】API 模式开关
# run_api.py 启动时已自动设置这两项；若通过其他方式启动（如直接 uvicorn）则需手动填写。
# =============================================================================

DISABLE_AUTH=true
API_ONLY_MODE=true


# =============================================================================
# 【建议配置】服务器运行参数
# =============================================================================

HOST=0.0.0.0
PORT=8000

# Worker 数量：
#   - K8s 单副本部署：建议 2-4
#   - K8s 多副本部署：建议每 Pod 设为 1，靠副本数横向扩展
WORKERS=2

# 生产环境必须关闭热重载和调试模式
RELOAD=false
DEBUG=false

LOG_LEVEL=INFO


# =============================================================================
# 【建议配置】安全
# =============================================================================

# [SECRET] 用于 JWT 签名的密钥，生产必须替换为随机字符串
# 生成命令：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32


# =============================================================================
# 【建议配置】缓存（Valkey / Redis）
# BackgroundTaskManager 依赖 Valkey 在多 Worker 间共享任务状态，
# 若不配置则任务状态仅存内存，多 Worker / 多副本时跨实例查询任务会 404。
# =============================================================================

# valkey 表示使用 Valkey/Redis；memory 表示仅内存（单 Worker 可用）
CACHE_BACKEND=valkey

# K8s 中 host 填 Valkey Service 名称
VALKEY_URL=valkey://landppt-valkey:6379


# =============================================================================
# 【按需配置】联网搜索增强
# 仅在调用 POST /v1/presentations 时传入 network_mode=true 才会触发，
# 不使用联网功能可跳过此分区。
# =============================================================================

# 搜索提供商：tavily（推荐，注册即有免费额度）/ searxng（私有实例，不依赖外部）
RESEARCH_PROVIDER=tavily

# [SECRET] Tavily API Key（使用 Tavily 时填写）
TAVILY_API_KEY=

# 使用私有 SearXNG 实例时填写（与 Tavily 二选一）
SEARXNG_HOST=


# =============================================================================
# 【按需配置】PPTX 导出
# 需要 Apryse SDK 授权才能将 PPT 导出为 .pptx 格式。
# 不配置时 PDF 和 HTML 导出不受影响，仅 PPTX 导出不可用。
# =============================================================================

ENABLE_APRYSE_PPTX_EXPORT=false

# [SECRET] Apryse 授权 Key（ENABLE_APRYSE_PPTX_EXPORT=true 时必须填写）
APRYSE_LICENSE_KEY=


# =============================================================================
# 【按需配置】PPT 内图片
# 默认关闭，生成纯文字版 PPT。如需 AI 配图再开启。
# =============================================================================

ENABLE_IMAGE_SERVICE=false

# 开启图片服务后的进一步配置（ENABLE_IMAGE_SERVICE=false 时以下配置无效）:
# ENABLE_AI_GENERATION=true
# DEFAULT_AI_IMAGE_PROVIDER=pollinations        # 免费；或 siliconflow / dalle
# SILICONFLOW_API_KEY=                          # 使用 siliconflow 时填写 [SECRET]


# =============================================================================
# 【按需配置】LLM 超时 & 生成参数
# 默认值对大多数场景够用，若生成超时再调大。
# =============================================================================

# LLM API 请求超时（秒），生成长 PPT 时可能需要调大到 900
LLM_TIMEOUT_SECONDS=600

# 单次最大生成 Token 数
MAX_TOKENS=16384

# 生成温度（0.0=确定性，1.0=创造性），0.7 为平衡值
TEMPERATURE=0.7


# =============================================================================
# 【按需配置】后台任务健康检测（多 Worker 时调大，避免长任务被误判为僵死）
# =============================================================================

# RUNNING 状态任务超过此时间未心跳则标记为 stale 并释放（秒）
BG_TASK_STALE_SECONDS=3600

# 任务心跳间隔（秒），任务执行中每隔此时间刷新 Valkey 里的 updated_at
BG_TASK_HEARTBEAT_SECONDS=30


# =============================================================================
# 以下内容在内部 API 部署中不需要，保持默认值或留空即可
# =============================================================================

# 用户注册 / OAuth / 邮件 / Credits 积分 / 视频导出 / ComfyUI TTS
# 均为面向终端用户的功能，内部 API 场景无需开启
ENABLE_CREDITS_SYSTEM=false
ENABLE_USER_REGISTRATION=false
TURNSTILE_ENABLED=false
GITHUB_OAUTH_ENABLED=false
LINUXDO_OAUTH_ENABLED=false
