# ============================================================================
# LandPPT API-only Mode Configuration
# No Authentication, Pure REST API
# ============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false
WORKERS=1
LOG_LEVEL=info

# API Mode Settings
DISABLE_AUTH=true
API_ONLY_MODE=true
ANONYMOUS_USER_ID=1

# ============================================================================
# AI Provider Configuration - Choose and configure your preferred provider
# ============================================================================

# OpenAI (recommended)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# GOOGLE_MODEL=gemini-1.5-flash

# Ollama (Local Models)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# Default AI Provider
DEFAULT_AI_PROVIDER=openai

# ============================================================================
# AI Generation Parameters
# ============================================================================

MAX_TOKENS=16384
TEMPERATURE=0.7
TOP_P=1.0
LLM_TIMEOUT_SECONDS=600

# Parallel Generation
ENABLE_PARALLEL_GENERATION=true
PARALLEL_SLIDES_COUNT=1

# Feature Flags
ENABLE_NETWORK_MODE=true
ENABLE_LOCAL_MODELS=false
ENABLE_STREAMING=true
ENABLE_AUTO_LAYOUT_REPAIR=false

# ============================================================================
# Research Configuration (Optional)
# ============================================================================

RESEARCH_PROVIDER=tavily

# Tavily API
# TAVILY_API_KEY=your_tavily_api_key_here
# TAVILY_MAX_RESULTS=10

# SearXNG
# SEARXNG_HOST=http://localhost:8080
# SEARXNG_MAX_RESULTS=10

# ============================================================================
# Image Configuration (Optional)
# ============================================================================

# Unsplash
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Pixabay
# PIXABAY_API_KEY=your_pixabay_api_key

# ============================================================================
# Export Configuration (Optional)
# ============================================================================

# Apryse SDK for advanced PPTX export (not required for basic export)
# APRYSE_LICENSE_KEY=your_apryse_license_key
# ENABLE_APRYSE_PPTX_EXPORT=false

# ============================================================================
# Database Configuration
# ============================================================================

# SQLite (default, no configuration needed)
# DATABASE_URL=sqlite:///./landppt_api.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/landppt
