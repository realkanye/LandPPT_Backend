# =============================================================================
# LandPPT Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the REQUIRED fields below.
# All other sections are optional and have safe defaults.
#
# Detailed reference: see DEPLOYMENT.md
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED: MongoDB
# -----------------------------------------------------------------------------
# The only persistent store the backend uses.
#
# Examples:
#   Local (no auth):   mongodb://localhost:27017/landppt
#   Auth + replicaset: mongodb://user:pass@host:27017/landppt?authSource=admin
#   MongoDB Atlas:     mongodb+srv://user:pass@cluster.mongodb.net/landppt
MONGODB_URL=mongodb://localhost:27017/landppt


# -----------------------------------------------------------------------------
# REQUIRED: Default AI provider
# -----------------------------------------------------------------------------
# One of: openai | anthropic | google | azure_openai | ollama
DEFAULT_AI_PROVIDER=openai


# -----------------------------------------------------------------------------
# REQUIRED: At least ONE AI provider key for the chosen DEFAULT_AI_PROVIDER
# -----------------------------------------------------------------------------

# --- OpenAI / OpenAI-compatible proxy ---
# Use OPENAI_BASE_URL to point at any compatible endpoint
# (Azure proxy, 国内中转, etc.).
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Ollama (local models) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3


# -----------------------------------------------------------------------------
# Optional: Server runtime parameters
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=2                  # Production 2~4. Forced to 1 if RELOAD=true.
RELOAD=false               # true = dev hot-reload (single worker)
LOG_LEVEL=info             # debug | info | warning | error


# -----------------------------------------------------------------------------
# Optional: Per-role model overrides
# -----------------------------------------------------------------------------
# Leave blank to use DEFAULT_AI_PROVIDER + that provider's default model.
# Useful when you want a stronger model for outline planning and a
# faster / cheaper one for per-slide SVG generation, etc.
OUTLINE_MODEL_PROVIDER=
OUTLINE_MODEL_NAME=
SLIDE_GENERATION_MODEL_PROVIDER=
SLIDE_GENERATION_MODEL_NAME=
DEFAULT_MODEL_PROVIDER=
DEFAULT_MODEL_NAME=


# -----------------------------------------------------------------------------
# Optional: LLM generation parameters
# -----------------------------------------------------------------------------
MAX_TOKENS=8192            # Per-call output cap
TEMPERATURE=0.7            # 0.0=deterministic, 1.0=creative
TOP_P=1.0
LLM_TIMEOUT_SECONDS=600    # Each LLM HTTP call. Bump for slow providers.


# -----------------------------------------------------------------------------
# Optional: Cache (Valkey / Redis)
# -----------------------------------------------------------------------------
# memory  = process-local in-memory cache (default; lost on restart, no IPC)
# valkey  = shared Valkey / Redis cache (recommended when WORKERS > 1)
CACHE_BACKEND=memory
VALKEY_URL=valkey://localhost:6379


# -----------------------------------------------------------------------------
# Optional: Web research (network_mode=true on requests)
# -----------------------------------------------------------------------------
# Provider: tavily | searxng | both
RESEARCH_PROVIDER=tavily

# --- Tavily ---
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10
TAVILY_SEARCH_DEPTH=advanced

# --- SearXNG (self-hosted alternative) ---
SEARXNG_HOST=
SEARXNG_MAX_RESULTS=10
SEARXNG_LANGUAGE=auto
SEARXNG_TIMEOUT=30


# -----------------------------------------------------------------------------
# Optional: API documentation visibility
# -----------------------------------------------------------------------------
# Set to false to hide /docs, /redoc, /openapi.json on a public deployment.
LANDPPT_ENABLE_API_DOCS=true
